; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Onirica"
config/version="1.1.0"
run/main_scene="uid://djaj5qaevc02v"
config/features=PackedStringArray("4.6", "Mobile")
boot_splash/stretch_mode=0
boot_splash/image="uid://cyjafl43akdhu"
config/icon="uid://cyjafl43akdhu"

[autoload]

Constants="*res://manager/constants.gd"
Commons="*res://manager/commons.gd"
SettingsManager="*res://manager/settings_manager.gd"
SignalManager="*res://manager/signal_manager.gd"
CardManager="*res://manager/card_manager.gd"
GameManager="*res://manager/game_manager.gd"
SceneManager="*res://manager/scene_manager.gd"
SoundManager="*uid://ccm14y2kvmt5u"
AudioManager="*res://manager/audio_manager.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_call_argument=1
gdscript/warnings/missing_await=1

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/stretch/mode="canvas_items"
window/handheld/orientation=1
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/log/plugin.cfg", "res://addons/sound_manager/plugin.cfg")

[global_group]

discard=""
labyrinth=""
limbo=""
deck=""
cards=""
prophecy_cards=""

[input_devices]

pointing/emulate_touch_from_mouse=true

[log_gd]

config/show_timestamps=true
config/timestamp_type=1

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
